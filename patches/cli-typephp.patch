+// PHP runtime on PATH) and dies on a clean one.
+async function assertTypephpBundle(cfg) {
+  const required = [cfg.name + '.exe', 'launcher.exe', 'app.exe', cfg.name + '.conf'];
+  if (!cfg.url) required.push('frontend/index.html');
+  const missing = [];
+  for (const f of required) if (!(await exists('dist/' + f))) missing.push(f);
