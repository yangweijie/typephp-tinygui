+// --- packing a REAL zip ------------------------------------------------------
+//
+// The Windows publish path packs with `tar -a`. That only works with bsdtar:
+// **GNU tar cannot write zip at all** — `-a` handles gzip/bzip2/xz/lzma/zstd and
+// silently falls back to an uncompressed POSIX TAR when the name says ".zip".
+// So the format of the release artifact depends on which `tar` is first on PATH,
+// and running the CLI from Git Bash (whose GNU tar wins over System32's bsdtar)
+// produces an 18 MB file called .zip that no consumer can open — while the
+// manifest happily advertises a sha256 for it. Pin the capable tar and verify the
+// bytes instead of trusting the extension.
+async function zipTar() {
+  if (IS_WIN) {
+    const root = tjs.env.SystemRoot || tjs.env.windir || 'C:\\Windows';
+    const sysTar = root.replace(/[\\/]+$/, '') + '\\System32\\tar.exe';
+    if (await exists(sysTar)) return sysTar;
+  }
+  return 'tar';
+}
+
+// First two bytes of a zip are "PK". A ".zip" that is really a tar is worse than
+// a failed build, because it looks like it worked.
+async function assertRealZip(path) {
+  const head = (await tjs.readFile(path)).subarray(0, 2);
+  if (head[0] !== 0x50 || head[1] !== 0x4b) {
+    fail(path.split('/').pop() + ' is not a zip archive — the tar that packed it ' +
+         'cannot write zip (GNU tar only does gzip/bzip2/xz and quietly produced a ' +
+         'plain tar). Windows ships a capable bsdtar at %SystemRoot%\\System32\\tar.exe;' +
+         '\n        make sure it is found, or pack the folder with a zip tool.');
+  }
+}
