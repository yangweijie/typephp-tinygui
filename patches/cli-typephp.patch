+// ---- TypePHP build --------------------------------------------------------
+//
+// `tinyjs build --typephp` assembles a portable dist/ folder instead of
+// compiling a JS bundle (.build/app + `tjs app compile` are both skipped — a
+// TypePHP project has no JS backend). The PHP backend itself is compiled by tpc,
+// which needs MSVC, so that stays YOUR build step; hook it with
+// tinyjs.json "typephp".build, or pre-compile and point "typephp".app at it.
+//
+//   dist/<name>.exe    the entry AND the pipe server (the C++ shim)
+//   dist/launcher.exe  the STOCK upstream launcher — --typephp is a dev-only
+//                      patch, because the entry spawns the launcher in the
+//                      normal (upstream) direction itself
+//   dist/app.exe       the compiled PHP backend
+//   dist/<name>.conf   per-app metadata the entry reads
+//   dist/*.dll         the PHP runtime DLLs app.exe imports
+//   dist/frontend/     the frontend files
+const TYPEPHP_RUNTIME_DLLS = [
+  'php8ts.dll', 'phpx.dll', 'libmpdec-4.0.1.dll', 'libmpdec++-4.0.1.dll',
+  'gmp-10.dll', 'mpfr-6.dll',
+];
+
+// --- TypePHP entry: the two properties the build hook cannot guarantee --------
+//
+// The packaged entry is the C++ shim, and the shim is built by a *project-owned*
+// shell hook ("typephp".build), so the CLI cannot assume anything about how it
+// was linked. Two things must hold for a shippable entry and neither is implied
+// by the hook, so enforce both here instead of trusting it.
+
+// 1. GUI subsystem. MinGW's default is a console (CUI) binary, and a shipped app
+//    is started by double-clicking <name>.exe in Explorer — a CUI entry docks a
+//    black console window for the entire lifetime of the app. Flip Subsystem
+//    3 (console) -> 2 (GUI) in the PE optional header: one 16-bit field, the same
+//    edit the upstream Windows build makes to its own entry. Nothing else in the
+//    file changes.
+//
+//    Returns 'gui' | 'patched' | 'other:<n>' | null (null = not a PE).
+async function forceGuiSubsystem(path) {
+  const buf = await tjs.readFile(path);
+  const dv = new DataView(buf.buffer, buf.byteOffset, buf.byteLength);
+  if (buf.byteLength < 0x40) return null;
+  const peOff = dv.getUint32(0x3c, true);
+  if (peOff + 0x5a > buf.byteLength) return null;
+  if (dv.getUint32(peOff, true) !== 0x00004550 /* "PE\0\0" */) return null;
+  const subsystemOff = peOff + 24 + 68; // OptionalHeader + Subsystem
+  if (subsystemOff + 2 > buf.byteLength) return null;
+  const cur = dv.getUint16(subsystemOff, true);
+  if (cur === 2) return 'gui';
+  if (cur !== 3) return 'other:' + cur;
+  dv.setUint16(subsystemOff, 2, true);
+  await tjs.writeFile(path, buf);
+  return 'patched';
+}
+
+// 2. File icon. The `icon=` line in <name>.conf only sets the *window and
+//    taskbar* icon at runtime (the entry passes it to the launcher as
+//    TINYJS_ICON); Explorer reads the icon out of the exe's PE resources. The
+//    launcher binary is the only icon-embedding tool we ship, so drive it.
+//
+//    Applied to the ENTRY only. dist/launcher.exe deliberately stays a
+//    byte-for-byte upstream build — that is the whole point of the packaged
+//    direction (no launcher patch in the distribution) — and it does not need a
+//    resource icon, because the conf handles its window icon.
+async function embedIcon(target, iconSrc) {
+  const tool = TOOL_DIR + 'native/launcher-win.exe';
+  if (!(await exists(tool))) return false;
+  return await tryRun([tool, '--embed-icon', tjs.cwd + '/' + target,
+                       tjs.cwd + '/' + iconSrc], { stderr: 'inherit' });
+}
+
