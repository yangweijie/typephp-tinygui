+    if (await embedIcon('dist/' + name + '.exe', iconSrc)) {
+      console.log('    icon embedded into ' + name + '.exe');
+    } else {
+      console.log('    WARNING: could not embed ' + iconSrc + ' into ' + name +
+                  '.exe — Explorer will show the default icon');
+    }
+  }
+  conf.push('app=app.exe');
+  conf.push('launcher=launcher.exe');
+  await tjs.writeFile('dist/' + name + '.conf', enc.encode(conf.join('\n') + '\n'));
+  console.log('    ' + name + '.conf');
+
+  // Do this LAST: it must not be undone by anything above (icon embedding in
+  // particular rewrites the whole PE, so re-assert the subsystem afterwards).
+  const entry = 'dist/' + name + '.exe';
+  const sub = await forceGuiSubsystem(entry);
+  if (sub === 'patched') {
+    console.log('    entry: PE subsystem console -> GUI (no console window on double-click)');
+  } else if (sub === 'gui') {
+    console.log('    entry: PE subsystem already GUI');
+  } else if (sub) {
+    console.log('    WARNING: ' + entry + ' has unexpected PE subsystem ' + sub +
+                ' — double-click may open a console window');
+  } else {
+    console.log('    WARNING: ' + entry + ' is not a PE image; cannot verify its subsystem');
+  }
+
+  console.log('==> dist/' + name + '.exe  (double-click to run, or zip dist/ to ship)');
+}
