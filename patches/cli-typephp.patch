+// ---- TypePHP backend mode -------------------------------------------------
+//
+// Normally the backend is a txiki.js module graph: `tjs run entry.js` builds the
+// app, then runtime/bridge.js spawns native/launcher-*.exe and answers its
+// frames over a pipe. In TypePHP mode the backend is a COMPILED PHP binary
+// (aot-compiler `tpc` output) speaking the same frames — but PHP cannot serve a
+// named pipe, so a tiny C shim (backend_shell.cpp → backend.exe) owns the pipe
+// and proxies to the PHP child over stdio. That shim is what the launcher
+// spawns, which inverts the usual direction: the LAUNCHER becomes the process
+// `tinyjs dev` spawns, and there is no entry.js, no bridge.js and no esbuild —
+// a TypePHP project needs no JS backend at all, so generateBuild() is skipped.
+//
+// Enabled with `tinyjs dev --typephp` or TINYJS_TYPEPHP=1. Windows-only until
+// the shim is ported to the POSIX launchers.
+function typephpEnabled() {
+  return args.includes('--typephp') || !!tjs.env.TINYJS_TYPEPHP;
+}
