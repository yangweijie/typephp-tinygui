#!/usr/bin/env bash
# ===========================================================================
# tgui — the TypePHP GUI command line (replaces tinyjsapp's patched cli.js).
#
#   gui/bin/tgui dev        run the current project with a compiled PHP backend
#   gui/bin/tgui build      assemble a portable dist/ bundle (no JS backend) —
#                           Windows: <name>.exe layout; macOS (Phase 21c): .app;
#                           Linux (Phase 22c): <name>/ dir layout
#   gui/bin/tgui publish    archive dist/ as dist.zip (or, when zip is absent,
#                           dist.tar.gz) — the name always states the format
#   gui/bin/tgui init       scaffold a tinyjs.json + frontend into the cwd
#   gui/bin/tgui status     show the resolved launcher / shim / app paths
#
# Everything is OURS now: the launcher lives at gui/host/src/, the protocol
# framework at gui/php/, and this tool — there is no external tinyjsapp checkout
# and no patch step. See gui/README.md.
#
# Build artifacts come from tools/build-all.bat + tools/build-launcher.sh
# (Windows), tools/build-macos.sh (macOS), tools/build-linux.sh (Linux); tgui
# just orchestrates them. dev needs an X display on Linux (real desktop or Xvfb).
# ===========================================================================
set -uo pipefail

CMD="${1:-help}"
shift || true

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BUILD="$ROOT/build"
RT="$BUILD/runtime"
OS="$(uname -s)"

# The macOS pieces (Phase 20/21b): dev works via launcher-macos --typephp; the
# packaged direction is one command; only `build` (PE stamping) stays
# Windows-only for now.
mac_guide() {
  printf '   !!   macOS: tgui %s is Windows-toolchain only for now.\n' "$CMD"
  printf '         Use the packaged direction instead:  bash tools/build-macos.sh --run\n'
  printf '         (macOS dev mode = Phase 21b; see docs/planning/task_plan.md)\n'
}

say()  { printf '\n== %s\n' "$*"; }
ok()   { printf '   ok   %s\n' "$*"; }
warn() { printf '   !!   %s\n' "$*"; }
die()  { printf '\n!! %s\n' "$*"; exit 1; }

# --- locate the three moving parts ------------------------------------------
# to_native: turn a (possibly relative / Cygwin) path into an absolute
# Windows-native path. The launcher and shim are NATIVE Windows binaries that
# read TYPEPHP_* from the environment; Git Bash only translates argv paths, NOT
# env vars, so we must hand them a form CreateProcessW/SetCurrentDirectoryW
# accept. We emit FORWARD-slash Windows paths (e.g. `D:/git/.../backend.exe`):
# Windows APIs accept them, and they avoid a backslash quirk that makes the
# native spawn fail. cygpath -w is idempotent on already-Windows paths.
to_native() {
  local p="$1"
  if command -v cygpath >/dev/null 2>&1; then
    cygpath -w "$p" | tr '\\' '/'
  elif command -v realpath >/dev/null 2>&1; then
    realpath "$p" 2>/dev/null   # macOS default win-paths don't exist: stay quiet
  else
    printf '%s' "$(cd "$(dirname "$p" 2>/dev/null)" && pwd)/$(basename "$p")" | tr '\\' '/'
  fi
}

launcher="$(to_native "${TINYGUI_LAUNCHER:-$RT/launcher-win.exe}")"
launcher="${launcher:-$BUILD/launcher-win.exe}"
shim="$(to_native "${TYPEPHP_BACKEND:-$RT/backend.exe}")"
shim="${shim:-$BUILD/backend_shell.exe}"
app="$(to_native "${TYPEPHP_APP:-$BUILD/app.exe}")"

# --- read the project's tinyjs.json (cwd) -----------------------------------
# JSON-aware reader: supports nested dotted keys (e.g. `typephp.app`,
# `frontend.dir`). php >= 8.1 is required by this project, so we parse with php
# (correctly handles nesting + types). No loose grep fallback: a missing key
# returns empty and the caller keeps its default.
cfg() { # cfg <dotted.key> -> value (scalar) or empty
  local key="$1" f="$PWD/tinyjs.json"
  [ -f "$f" ] || return 1
  command -v php >/dev/null 2>&1 || return 1
  php -r '
    $j = @json_decode(file_get_contents($argv[1]), true);
    if (!is_array($j)) exit(1);
    $v = $j;
    foreach (explode(".", $argv[2]) as $k) {
      if (!is_array($v) || !array_key_exists($k, $v)) exit(1);
      $v = $v[$k];
    }
    if (!is_scalar($v)) exit(1);
    echo $v;
  ' "$f" "$key" 2>/dev/null
}

TITLE="$(cfg title || true)"; TITLE="${TITLE:-tinyjs}"
SIZE="$(cfg size || true)";  SIZE="${SIZE:-960x640}"
VERSION="$(cfg version || true)"; VERSION="${VERSION:-0.0.0}"
FE="$(cfg 'frontend.dir' || true)"; FE="${FE:-src/frontend}"
APP_CFG="$(cfg 'typephp.app' || true)"
SHIM_CFG="$(cfg 'typephp.backend' || true)"

case "$CMD" in
  help|--help|-h)
    sed -n '3,20p' "${BASH_SOURCE[0]}"
    ;;

  status)
    say "resolved toolchain"
    printf '   %-14s %s\n' launcher "$([ -f "$launcher" ] && echo "$launcher" || echo "MISSING ($launcher)")"
    printf '   %-14s %s\n' shim     "$([ -f "$shim" ] && echo "$shim" || echo "MISSING ($shim)")"
    printf '   %-14s %s\n' app      "$([ -f "$app" ] && echo "$app" || echo "MISSING ($app)")"
    if [ "$OS" = Darwin ]; then
      say "macOS toolchain (packaged direction)"
      printf '   %-14s %s\n' shim     "$([ -x "$BUILD/backend_shell" ] && echo "$BUILD/backend_shell" || echo "MISSING — bash tools/build-macos.sh")"
      printf '   %-14s %s\n' launcher "$([ -x "$BUILD/launcher-macos" ] && echo "$BUILD/launcher-macos" || echo "MISSING — bash tools/build-macos.sh")"
      printf '   %-14s %s\n' backend  "$([ -x "$ROOT/bin/run-backend.php" ] && echo "$ROOT/bin/run-backend.php" || echo "MISSING")"
      echo
      warn "on macOS: 'tgui dev' works (launcher-macos --typephp); 'tgui build'"
      warn "  assembles a real .app (needs php on PATH); packaged run:"
      warn "  bash tools/build-macos.sh --run (staged dir, no bundle)"
    elif [ "$OS" = Linux ]; then
      say "Linux toolchain (dev = shim serves the endpoint, pristine launcher connects)"
      printf '   %-14s %s\n' shim     "$([ -x "$BUILD/backend_shell" ] && echo "$BUILD/backend_shell" || echo "MISSING — bash tools/build-linux.sh")"
      printf '   %-14s %s\n' launcher "$([ -x "$BUILD/launcher-linux" ] && echo "$BUILD/launcher-linux" || echo "MISSING — bash tools/build-linux.sh")"
      printf '   %-14s %s\n' backend  "$([ -x "$ROOT/bin/run-backend.php" ] && echo "$ROOT/bin/run-backend.php" || echo "MISSING")"
      echo
      warn "on Linux: 'tgui dev' needs an X display (a real desktop, or"
      warn "  DISPLAY=:99 with Xvfb running). launcher-linux is kept PRISTINE —"
      warn "  no --typephp patch — so dev spawns the shim as endpoint server."
    fi
    ;;

  dev)
    if [ "$OS" = Darwin ]; then
      # macOS dev (Phase 21b): launcher-macos understands --typephp. Defaults
      # point at the mac artifacts built by tools/build-macos.sh.
      launcher="${TINYGUI_LAUNCHER:-$BUILD/launcher-macos}"
      shim="${TYPEPHP_BACKEND:-$BUILD/backend_shell}"
      app="${TYPEPHP_APP:-$ROOT/bin/run-backend.php}"
      [ -x "$app" ] || chmod +x "$app" 2>/dev/null || true  # shim execv's it
    elif [ "$OS" = Linux ]; then
      # Linux dev (Phase 22b): launcher-linux stays PRISTINE — it never learned
      # `--typephp`, and patching it would throw away the one property that
      # makes the tier-4 evidence meaningful (the shipped launcher is an
      # upstream build). So the direction is inverted instead: the shim owns the
      # AF_UNIX endpoint (dev-server position = endpoint name as argv[1]) and
      # the stock launcher connects to it as a client. The lifecycle chain is
      # identical — kill the launcher, the shim's endpoint-EOF teardown reaps
      # the PHP child and exits — so the watcher below needs no Linux branch.
      launcher="${TINYGUI_LAUNCHER:-$BUILD/launcher-linux}"
      shim="${TYPEPHP_BACKEND:-$BUILD/backend_shell}"
      app="${TYPEPHP_APP:-$ROOT/bin/run-backend.php}"
      [ -x "$app" ] || chmod +x "$app" 2>/dev/null || true  # shim execv's it
    fi
    [ -f "$launcher" ] || die "launcher missing: $launcher — run tools/build-launcher.sh (Windows) / tools/build-macos.sh (macOS) / tools/build-linux.sh (Linux)"
    [ -f "$shim" ]     || die "shim missing: $shim — run tools/build-all.bat (Windows) / tools/build-macos.sh (macOS) / tools/build-linux.sh (Linux)"
    [ -f "$app" ]      || die "app missing: $app — run tools/build-all.bat (Windows); on macOS/Linux the default is bin/run-backend.php"
    FE_DIR="$PWD/$FE"
    HTML="$(to_native "$FE_DIR/index.html")"
    [ -f "$HTML" ] || die "frontend not found: $HTML"
    TP_ENV=("$shim" "$app")
    # tinyjs.json typephp.{backend,app} are project-relative and, in the
    # templates, Windows .exe paths. On macOS/Linux a configured path that does
    # not exist falls back to the platform defaults instead of failing at spawn.
    cfg_override() { # cfg_override <slot-index> <project-relative path>
      [ -n "$2" ] || return 0
      if [ "$OS" = Darwin ] || [ "$OS" = Linux ]; then
        [ -e "$PWD/$2" ] || return 0
      fi
      TP_ENV[$1]="$(to_native "$PWD/$2")"
    }
    cfg_override 0 "$SHIM_CFG"
    cfg_override 1 "$APP_CFG"
    ICON="$(cfg icon || true)"; ICON="${ICON:-icon.png}"
    [ -f "$PWD/$ICON" ] && export TINYJS_ICON="$(to_native "$PWD/$ICON")"
    export TYPEPHP_BACKEND="$(to_native "${TP_ENV[0]}")"
    export TYPEPHP_APP="$(to_native "${TP_ENV[1]}")"
    export TYPEPHP_CWD="$(to_native "$PWD")"
    export TINYJS_DEBUG="${TINYJS_DEBUG:-dev}"
    say "dev: $HTML  (title=$TITLE size=$SIZE)"
    ok "launcher $launcher"
    ok "backend  ${TP_ENV[1]}"
    # Hot restart: there is no JS process in the loop, so the CLI's only lever
    # on the launcher is its LIFECYCLE — a change kills the launcher, the
    # shim's endpoint-EOF teardown reaps the PHP child, and the window
    # respawns (a visible bounce). Watcher runs on BOTH dev directions
    # (macOS Phase 21b; Windows restored in Phase 21e — Git Bash carries GNU
    # coreutils stat, which is why hot_snap probes -c vs -f instead of
    # hardcoding one dialect).
    if stat -f '%m' / >/dev/null 2>&1; then STAT_MTIME=(-f '%m %N')   # BSD (macOS)
    else STAT_MTIME=(-c '%Y %n'); fi                                  # GNU (Git Bash/Linux)
    hot_snap() { # mtime+name digest of every watched source file
      find "$@" -type f \( -name '*.php' -o -name '*.html' -o -name '*.js' \
                        -o -name '*.css' -o -name '*.json' \) 2>/dev/null \
        -exec stat "${STAT_MTIME[@]}" {} + | sort | cksum
    }
    child=""
    dev_shim=""
    restarting=0
    if [ "$OS" = Linux ]; then
      # The dev endpoint + log live under /tmp deliberately: the shim binds
      # AF_UNIX, and sun_path caps at ~108 bytes (bug #15).
      DEV_SOCK="${TINYGUI_DEV_SOCK:-/tmp/tinyjs-typephp-dev-$$.sock}"
      DEV_LOG="${TINYGUI_DEV_LOG:-/tmp/tinyjs-typephp-dev-$$.log}"
    fi
    dev_spawn() {
      if [ "$OS" = Linux ]; then
        # Left in append mode on purpose (the shim opens it with "a"): one log
        # then holds every dev cycle, which is what makes a bounce provable.
        rm -f "$DEV_SOCK"
        TYPEPHP_SHELL_LOG="$DEV_LOG" TYPEPHP_APP="${TP_ENV[1]}" TYPEPHP_CWD="$PWD" \
          "${TP_ENV[0]}" "$DEV_SOCK" &
        dev_shim=$!
        # The pristine launcher is a plain client with no connect-retry loop
        # (that loop is part of the --typephp patch win/mac carry), so wait for
        # the server socket to appear before spawning it.
        local i=0
        while [ ! -S "$DEV_SOCK" ] && [ "$i" -lt 100 ]; do sleep 0.1; i=$((i+1)); done
        [ -S "$DEV_SOCK" ] || { kill "$dev_shim" 2>/dev/null
          die "shim never created $DEV_SOCK — see $DEV_LOG"; }
        "$launcher" "$HTML" "$DEV_SOCK" "$TITLE" "$SIZE" "$VERSION" &
        child=$!
      else
        "$launcher" --typephp "$HTML" "$TITLE" "$SIZE" "$VERSION" &
        child=$!
      fi
    }
    dev_reap_shim() { # bounded wait for the shim's EOF teardown, then escalate
      [ "$OS" = Linux ] || return 0
      local i=0
      while kill -0 "$dev_shim" 2>/dev/null && [ "$i" -lt 50 ]; do
        sleep 0.1; i=$((i+1))
      done
      if kill -0 "$dev_shim" 2>/dev/null; then
        warn "shim still up 5s after the launcher exited — killing it (EOF teardown did not run)"
        kill "$dev_shim" 2>/dev/null
      fi
      wait "$dev_shim" 2>/dev/null
      rm -f "$DEV_SOCK"
    }
    while true; do
      dev_spawn
      WATCH=("$PWD/src")
      [ "$PWD" != "$ROOT" ] && WATCH+=("$ROOT/src" "$ROOT/gui/php/src")
      snap="$(hot_snap "${WATCH[@]}")"
      while kill -0 "$child" 2>/dev/null; do
        sleep 1
        if [ "$(hot_snap "${WATCH[@]}")" != "$snap" ]; then
          restarting=1
          ok "sources changed — bouncing the window (launcher kill + respawn)"
          kill "$child" 2>/dev/null
          break
        fi
      done
      wait "$child" 2>/dev/null
      dev_reap_shim
      [ "$restarting" = 1 ] || break
      restarting=0
    done
    [ "$OS" = Linux ] && ok "shim log: $DEV_LOG"
    ;;

  build)
    if [ "$OS" = Linux ]; then
      # Linux packaged direction (Phase 22c): a portable app DIRECTORY.
      #   dist/<name>/<name>           the shim, the double-click/CLI entry
      #                                (argc==1 -> launch mode -> reads <name>.conf).
      #                                The stem must contain NO '.': the shim
      #                                derives the conf name from the part BEFORE
      #                                the first dot, so "TypePHP.Demo" would seek
      #                                "TypePHP.conf". We sanitize that here.
      #   dist/<name>/<name>.conf      html/app/launcher/icon, RELATIVE to that dir
      #   dist/<name>/launcher-linux   pristine upstream build (no --typephp patch
      #                                in the distribution — that flag is dev-only)
      #   dist/<name>/frontend/        the page
      #   dist/<name>/app/{bin,src,gui/php/src}  byte-identical MIRROR of the repo
      #                                layout, so bin/run-backend.php's
      #                                require __DIR__.'/../src/backend.php' keeps
      #                                resolving without editing a single byte.
      # There is no PE/icon stamping and no tpc/AOT backend here: the entry needs
      # stock `php` on the TARGET's PATH, plus GTK3 + webkit2gtk at the same ABI
      # the build machine had (the launcher is dynamically linked). Both are
      # documented limitations, not silent ones.
      for req in "$BUILD/launcher-linux" "$BUILD/backend_shell" \
                 "$ROOT/bin/run-backend.php" "$ROOT/src/backend.php" \
                 "$ROOT/gui/php/src/Tiny/Gui/bootstrap.php"; do
        [ -f "$req" ] || die "missing $req — run: bash tools/build-linux.sh"
      done
      NAME="$(cfg name || true)"; NAME="${NAME:-app}"
      NAME="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9._-' '-')"   # shell-safe charset
      STEM="${NAME%%.*}"   # the shim's stem_of() = the part BEFORE the first '.',
      [ "$STEM" = "$NAME" ] || warn "name contains '.' — entry shortened to '$STEM' so <name>.conf resolves"
      NAME="$STEM"         # which is also the conf file it looks for
      D="dist/$NAME"
      say "build: $D"
      rm -rf dist
      mkdir -p "$D/frontend" "$D/app/bin" "$D/app/src" "$D/app/gui/php/src"
      cp -f "$BUILD/backend_shell"  "$D/$NAME"
      cp -f "$BUILD/launcher-linux" "$D/launcher-linux"
      cp -f  "$ROOT/bin/run-backend.php" "$D/app/bin/"
      cp -f  "$ROOT/src/backend.php"     "$D/app/src/"
      cp -Rf "$ROOT/gui/php/src/Tiny"    "$D/app/gui/php/src/"
      chmod +x "$D/$NAME" "$D/launcher-linux" "$D/app/bin/run-backend.php"
      cp -rf "$PWD/$FE/." "$D/frontend/"
      ICON="$(cfg icon || true)"; ICON="${ICON:-icon.png}"
      ICON_LINE=""
      if [ -f "$PWD/$ICON" ]; then
        cp -f "$PWD/$ICON" "$D/$ICON"
        ICON_LINE="icon=$ICON"   # the shim exports it as TINYJS_ICON, which launcher-linux reads
      else
        warn "no $ICON beside tinyjs.json — app ships without a window icon"
      fi
      {
        echo "# generated by tgui build ($(date -u '+%Y-%m-%dT%H:%M:%SZ'))"
        echo "html=frontend/index.html"
        echo "title=$TITLE"
        echo "size=$SIZE"
        echo "version=$VERSION"
        echo "app=app/bin/run-backend.php"
        echo "launcher=launcher-linux"
        [ -n "$ICON_LINE" ] && echo "$ICON_LINE"
      } > "$D/$NAME.conf"
      # Structural check, not a smoke test: this verifies the LAYOUT the shim
      # will actually resolve (conf re-parsed with stem semantics, exec bits,
      # ELF header/arch, mirror completeness, sun_path budget). The live
      # end-to-end run is Phase 22d's job.
      if [ -x "$ROOT/tools/verify-bundle-linux.sh" ] \
         || [ -f "$ROOT/tools/verify-bundle-linux.sh" ]; then
        bash "$ROOT/tools/verify-bundle-linux.sh" "$D" \
          || die "bundle verification FAILED — see checks above"
        ok "verify-bundle-linux.sh: all checks passed"
      else
        warn "tools/verify-bundle-linux.sh missing — bundle NOT verified"
      fi
      warn "target machine needs: stock php on PATH, GTK3 + webkit2gtk-4.1, and an X display"
      ok "$D/  ($NAME + launcher-linux + frontend/ + app/ backend mirror)"
      exit 0
    fi
    if [ "$OS" = Darwin ]; then
      # macOS packaged direction (Phase 21c): a real .app bundle.
      #   Contents/MacOS/App              the shim, CFBundleExecutable — the
      #                                   double-click entry (argc==1 -> launch
      #                                   mode -> reads App.conf). The binary
      #                                   name has NO dot on purpose: the shim
      #                                   derives the conf name from the exe
      #                                   stem BEFORE the first '.', so
      #                                   "TypePHP-Demo" would seek ".conf"
      #                                   under way too short a stem… keep "App".
      #   Contents/MacOS/App.conf         html/app/launcher paths, RELATIVE to
      #                                   MacOS/ ("../Resources/…" is fine)
      #   Contents/MacOS/launcher-macos   spawned by the shim (stock contract)
      #   Contents/Resources/frontend/    the page
      #   Contents/Resources/app/{bin,src,gui/php/src}  MIRROR of the repo
      #                                   layout so backend.php's
      #                                   require ../gui/php/… keeps working
      #                                   byte-identical. Needs stock `php` on
      #                                   PATH (tpc is Windows-only; documented).
      #   Contents/Resources/AppIcon.icns icon equivalent of win PE stamping
      for req in "$BUILD/launcher-macos" "$BUILD/backend_shell" \
                 "$ROOT/bin/run-backend.php" "$ROOT/src/backend.php" \
                 "$ROOT/gui/php/src/Tiny/Gui/bootstrap.php"; do
        [ -f "$req" ] || die "missing $req — run tools/build-macos.sh"
      done
      NAME="$(cfg name || true)"; NAME="${NAME:-app}"
      NAME="${NAME// /-}"
      B="dist/$NAME.app"; C="$B/Contents"
      say "build: $B"
      rm -rf dist
      mkdir -p "$C/MacOS" "$C/Resources/frontend" \
               "$C/Resources/app/bin" "$C/Resources/app/src" "$C/Resources/app/gui/php/src"
      cp -f "$BUILD/backend_shell"  "$C/MacOS/App"
      cp -f "$BUILD/launcher-macos" "$C/MacOS/launcher-macos"
      chmod +x "$C/MacOS/App" "$C/MacOS/launcher-macos"
      # backend: byte-identical copies mirroring the repo's relative paths
      cp -f  "$ROOT/bin/run-backend.php" "$C/Resources/app/bin/"
      cp -f  "$ROOT/src/backend.php"     "$C/Resources/app/src/"
      cp -Rf "$ROOT/gui/php/src/Tiny"    "$C/Resources/app/gui/php/src/"
      chmod +x "$C/Resources/app/bin/run-backend.php"   # execv'd without argv
      cp -rf "$PWD/$FE/." "$C/Resources/frontend/"
      printf 'html=../Resources/frontend/index.html\ntitle=%s\nsize=%s\nversion=%s\napp=../Resources/app/bin/run-backend.php\nlauncher=launcher-macos\n' \
        "$TITLE" "$SIZE" "$VERSION" > "$C/MacOS/App.conf"
      ICON_PLIST=""
      # icon: PNG -> iconset -> icns (the macho counterpart of PE stamping)
      ICON="$(cfg icon || true)"; ICON="${ICON:-icon.png}"
      if [ -f "$PWD/$ICON" ]; then
        iset="$C/Resources/AppIcon.iconset"; mkdir -p "$iset"
        # iconutil demands exactly these names; sips -z resizes (upscales too).
        genicon() { sips -z "$1" "$1" "$PWD/$ICON" --out "$iset/$2" >/dev/null 2>&1; }
        genicon 16   icon_16x16.png;       genicon 32   icon_16x16@2x.png
        genicon 32   icon_32x32.png;       genicon 64   icon_32x32@2x.png
        genicon 128  icon_128x128.png;     genicon 256  icon_128x128@2x.png
        genicon 256  icon_256x256.png;     genicon 512  icon_256x256@2x.png
        genicon 512  icon_512x512.png;     genicon 1024 icon_512x512@2x.png
        if iconutil -c icns "$iset" -o "$C/Resources/AppIcon.icns" 2>/dev/null; then
          rm -rf "$iset"
          ICON_PLIST="  <key>CFBundleIconFile</key><string>AppIcon</string>"
          ok "AppIcon.icns generated from $ICON"
        else
          rm -rf "$iset"
          warn "iconutil failed — bundle ships without an icon (entry keeps the generic app icon)"
        fi
      else
        warn "no $ICON beside tinyjs.json — bundle ships without an icon"
      fi
      # Info.plist: identity + the TCC usage strings the linked frameworks
      # (WebKit getUserMedia, Speech) demand — a missing string is a hard crash
      # at first use, not a polite denial.
      BID="com.typephp.$(printf '%s' "$NAME" | tr -cd '[:alnum:]')"
      cat > "$C/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>$NAME</string>
  <key>CFBundleDisplayName</key><string>$TITLE</string>
  <key>CFBundleExecutable</key><string>App</string>
  <key>CFBundleIdentifier</key><string>$BID</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$VERSION</string>
  <key>CFBundleVersion</key><string>$VERSION</string>
$ICON_PLIST
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSCameraUsageDescription</key><string>$TITLE uses the camera when a page requests it (tiny.getMedia).</string>
  <key>NSMicrophoneUsageDescription</key><string>$TITLE uses the microphone when a page requests it (tiny.getMedia).</string>
  <key>NSSpeechRecognitionUsageDescription</key><string>$TITLE supports speech recognition for pages that request it.</string>
</dict>
</plist>
PLIST
      # No codesign step HERE, deliberately (measured, macOS 26 codesign):
      # whole-bundle ad-hoc signing refuses this layout — every file under
      # Contents/ (incl. App.conf, mode 644) gets sealed as a subcomponent —
      # and in-bundle per-binary signing leaves the principal exe with a
      # bundle-style signature that then fails raw verification. The binaries
      # keep their LINKER ad-hoc signatures, which is exactly what ran through
      # Phase 20/21b. Developer ID + notarization is a separate, future
      # distribution concern (docs/planning/task_plan.md).
      if command -v python3 >/dev/null 2>&1 && [ -f "$ROOT/tools/verify-bundle-macos.py" ]; then
        python3 "$ROOT/tools/verify-bundle-macos.py" "$B" \
          || die "bundle verification FAILED — see checks above"
        ok "verify-bundle-macos.py: all checks passed"
      else
        warn "python3 or tools/verify-bundle-macos.py missing — bundle NOT verified"
      fi
      ok "$B (App + launcher-macos + frontend/ + app/ backend + runtime via system php)"
      exit 0
    fi
    [ -f "$app" ]  || die "app missing: $app — run tools/build-all.bat"
    [ -f "$shim" ] || die "shim missing: $shim — run tools/build-all.bat"
    NAME="$(cfg name || true)"; NAME="${NAME:-app}"
    NAME="${NAME// /-}"                                  # sanitize (no spaces in exe name)
    PHP_BIN="php.exe"   # the AOT PHP backend — a DISTINCT name from the entry shim
    FE_DIR="$PWD/$FE"   # frontend source (mirrors the dev case)
    say "build: dist/$NAME/"
    rm -rf dist
    mkdir -p "dist/frontend"
    # The shim is the user-facing ENTRY: double-clicking it reads dist/$NAME.conf,
    # spins up the PHP backend ($PHP_BIN) and the WebView launcher (launcher.exe).
    # The PHP backend is an internal binary and must NOT share the entry's name.
    cp -f "$shim"     "dist/$NAME.exe"
    cp -f "$launcher" "dist/launcher.exe"
    cp -f "$app"      "dist/$PHP_BIN"
    # Runtime DLLs. $RT (build/runtime) holds the MinGW runtime that the launcher
    # + shim import (libgcc_s_seh-1.dll, libstdc++-6.dll, possibly more); $BUILD
    # holds the PHP runtime the AOT backend imports. Copy both sets.
    for d in "$RT"/*.dll "$BUILD"/*.dll; do
      [ -f "$d" ] && cp -f "$d" "dist/$(basename "$d")"
    done
    [ -d "$FE_DIR" ] && cp -rf "$FE_DIR/." "dist/frontend/"
    # PE post-processing on the ENTRY (the old cli.js did this; the fused CLI
    # must too, or double-click docks a black console and Explorer shows a
    # generic icon — shipped-bug #10 in docs/planning/task_plan.md):
    #   1. stamp the project icon into the entry's PE resources via the
    #      launcher's own --embed-icon tool (this REWRITES the whole PE), then
    #   2. flip PE OptionalHeader.Subsystem console->GUI — MUST be the last
    #      step precisely because step 1 rewrites the file.
    ICON="$(cfg icon || true)"; ICON="${ICON:-icon.png}"
    if [ -f "$PWD/$ICON" ]; then
      if "$launcher" --embed-icon "dist/$NAME.exe" "$ICON"; then
        ok "icon stamped into dist/$NAME.exe (launcher --embed-icon)"
      else
        warn "icon embedding failed — entry keeps the generic exe icon"
      fi
    else
      warn "no $ICON beside tinyjs.json — entry ships without an icon resource"
    fi
    php -r '
      $f = $argv[1];
      $d = @file_get_contents($f);
      if ($d === false || substr($d, 0, 2) !== "MZ") exit(1);
      $pe = unpack("V", substr($d, 0x3C, 4))[1];
      if ($pe + 24 + 70 > strlen($d) || substr($d, $pe, 4) !== "PE\0\0") exit(1);
      $off = $pe + 24 + 68;              /* OptionalHeader.Subsystem (uint16) */
      $sub = unpack("v", substr($d, $off, 2))[1];
      if ($sub !== 3) exit(0);           /* not console — nothing to flip */
      $d[$off] = "\x02";
      file_put_contents($f, $d);
    ' "dist/$NAME.exe" \
      && ok "PE subsystem console -> GUI (no console window on double-click)" \
      || die "failed to patch PE subsystem on dist/$NAME.exe"
    {
      echo "# generated by tgui build"
      echo "html=${FE##*/}/index.html"; echo "title=$TITLE"; echo "size=$SIZE"
      echo "version=$VERSION"; echo "app=$PHP_BIN"; echo "launcher=launcher.exe"
    } > "dist/$NAME.conf"
    ok "dist/$NAME.exe (entry) + launcher.exe + $PHP_BIN + frontend/ + runtime DLLs"
    ;;

  publish)
    [ -d dist ] || die "no dist/ — run 'tgui build' first"
    # ONE artifact, named for the format it actually is (lesson #11: a tarball
    # renamed .zip is a broken promise, not a smaller one). zip is what Windows
    # users expect and what the auto-update flow unpacks; Linux containers often
    # have no zip, so tar.gz is the honest fallback.
    if command -v zip >/dev/null 2>&1; then
      say "publish: zip dist/"
      ( cd dist && zip -r -q "../dist.zip" . ) || die "zip failed"
      OUT="$PWD/dist.zip"
    elif [ "$OS" = Linux ]; then
      say "publish: tar.gz dist/ (no zip on this machine)"
      tar -czf dist.tar.gz -C dist . || die "tar failed"
      OUT="$PWD/dist.tar.gz"
    else
      die "no zip available — install zip, or (on Linux) use tar.gz"
    fi
    ok "$(basename "$OUT")  ($(wc -c < "$OUT" | tr -d ' ') bytes) — keep the extension: it names the format"
    ;;

  init)
    say "init: scaffold in $PWD"
    [ -f tinyjs.json ] && die "tinyjs.json already exists"
    cat > tinyjs.json <<JSON
{
  "name": "my-app",
  "title": "My App",
  "size": "960x640",
  "version": "0.1.0",
  "frontend": { "dir": "src/frontend" },
  "icon": "icon.png",
  "typephp": { "app": "build/app.exe" }
}
JSON
    mkdir -p src/frontend
    cat > src/frontend/index.html <<HTML
<!doctype html><meta charset="utf-8"><title>My App</title>
<h1>Hello from PHP</h1>
<button onclick="call('api.now').then(r=>document.body.innerHTML+='<pre>'+JSON.stringify(r)+'</pre>')">ping backend</button>
<script src="tiny.js"></script>
HTML
    ok "tinyjs.json + src/frontend/index.html"
    ;;

  *)
    die "unknown command: $CMD (try: dev | build | publish | init | status)"
    ;;
esac
