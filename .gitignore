# ---------------------------------------------------------------------------
# Build outputs — everything here is regenerated by tools/build-all.bat,
# tools/build-launcher.sh or a tpc compile. Never commit them.
# ---------------------------------------------------------------------------
/build/
dist/
dist.zip
dist.tar.gz
*.exe
*.exp
*.lib
*.obj
*.o
*.pdb
*.ilk
*.res

# PHP runtime DLLs copied out of the tpc distro (≈15.5 MB, 3 duplicated sets).
*.dll

# tpc intermediate output
/build-*/
**/build/*.cc
**/build/*.h
*.typephp-cache

# Generated by gui/host/script/gen-client.sh — embeds gui/runtime/tiny.js
gui/host/src/tiny_client.h
*.parts.json
*.rsp

# ---------------------------------------------------------------------------
# Test scratch — the POSIX kit recreates these on every run.
# ---------------------------------------------------------------------------
.work/
.work-*/
**/.work/
**/.work-*/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~

# Local overrides (toolchain paths etc.)
.env
.env.local
toolchain.local.sh

# Composer install output (this repo is type=project; do not commit vendor/)
/vendor/

# ---------------------------------------------------------------------------
# 文档站（VuePress 2，源码在 docs/）。站点 markdown 要提交，工具链产物不要：
# node_modules / .vuepress 的 temp+cache 都是生成物。dist/ 已被上面的规则覆盖。
# ---------------------------------------------------------------------------
docs/node_modules/
docs/.vuepress/.temp/
docs/.vuepress/.cache/
# sync-external.sh 每次构建前重生成的镜像页
docs/reference/

# ---------------------------------------------------------------------------
# Evidence: keep tracked kit/e2e artifacts (evidence/e2e/e2e-*, evidence/kit/).
# Ignore local scratch dumps from TYPEPHP_SHELL_LOG / ad-hoc runs.
# ---------------------------------------------------------------------------
evidence/e2e/dev*.log
evidence/e2e/direct.log
evidence/e2e/manual_shim.log
evidence/e2e/tgui_env.log
evidence/e2e/pub_real*.log
